<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.cliqheart.app.feature.splash.SplashFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_splash_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_mainShell"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.cliqheart.app.feature.welcome.WelcomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_welcome_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_welcome_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.cliqheart.app.feature.auth.LoginFragment"
        android:label="@string/login_title" />

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.cliqheart.app.feature.auth.SignupFragment"
        android:label="@string/signup_title" />

    <fragment
        android:id="@+id/mainShellFragment"
        android:name="com.cliqheart.app.feature.home.MainShellFragment"
        android:label="@string/app_name" />
</navigation>
