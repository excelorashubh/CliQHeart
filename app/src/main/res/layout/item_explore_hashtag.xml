<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_explore_search"
        android:gravity="center"
        android:text="#"
        android:textColor="@color/heart_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hashtag_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/heart_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hashtag_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/heart_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
