<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_menu_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@color/heart_outline" />

    <TextView
        android:id="@+id/profile_menu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:text="@string/profile_menu_title"
        android:textColor="@color/heart_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/profile_menu_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="24dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/heart_muted"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="4dp"
                android:text="@string/profile_menu_account"
                android:textColor="@color/heart_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profile_menu_edit_profile"
                style="@style/ProfileMenuRow"
                android:contentDescription="@string/edit_profile">
                <ImageView
                    style="@style/ProfileMenuIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_menu_edit" />
                <TextView
                    style="@style/ProfileMenuLabel"
                    android:text="@string/edit_profile" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_menu_activity_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="@string/profile_menu_your_activity"
                android:textColor="@color/heart_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profile_menu_saved"
                style="@style/ProfileMenuRow"
                android:contentDescription="@string/saved">
                <ImageView
                    style="@style/ProfileMenuIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_menu_saved" />
                <TextView
                    style="@style/ProfileMenuLabel"
                    android:text="@string/saved" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_menu_professional_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="@string/profile_menu_professional"
                android:textColor="@color/heart_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/profile_menu_professional"
                style="@style/ProfileMenuRow"
                android:contentDescription="@string/professional_dashboard"
                android:visibility="gone">
                <ImageView
                    style="@style/ProfileMenuIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_menu_dashboard" />
                <TextView
                    style="@style/ProfileMenuLabel"
                    android:text="@string/professional_dashboard" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="4dp"
                android:text="@string/profile_menu_preferences"
                android:textColor="@color/heart_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profile_menu_notifications"
                style="@style/ProfileMenuRow"
                android:contentDescription="@string/notifications">
                <ImageView
                    style="@style/ProfileMenuIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_menu_notifications" />
                <TextView
                    style="@style/ProfileMenuLabel"
                    android:text="@string/notifications" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/heart_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingBottom="4dp"
                android:text="@string/profile_menu_session"
                android:textColor="@color/heart_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profile_menu_logout"
                style="@style/ProfileMenuRow"
                android:contentDescription="@string/log_out">
                <ImageView
                    style="@style/ProfileMenuIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_profile_menu_logout"
                    android:tint="@color/heart_primary" />
                <TextView
                    style="@style/ProfileMenuLabel"
                    android:text="@string/log_out"
                    android:textColor="@color/heart_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
