<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigation_item"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:minHeight="48dp"
    android:paddingStart="2dp"
    android:paddingTop="4dp"
    android:paddingEnd="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/navigation_icon_container"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/navigation_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:id="@+id/navigation_avatar_frame"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_avatar_placeholder"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/navigation_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:background="@drawable/bg_nav_avatar_placeholder"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/navigation_badge"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_nav_badge"
                android:gravity="center"
                android:minWidth="17dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/navigation_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
