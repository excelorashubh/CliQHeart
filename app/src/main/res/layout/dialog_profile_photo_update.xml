<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/profile_photo_preview"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_avatar_circle"
        android:clipToOutline="true"
        android:contentDescription="@string/profile_photo_preview"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile" />

    <TextView
        android:id="@+id/profile_photo_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/profile_photo_select_prompt"
        android:textColor="@color/heart_muted"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/profile_photo_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone" />
</LinearLayout>
