<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@color/heart_surface"
    android:orientation="vertical">

    <!-- Header: Avatar, Name, Location, Follow, Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/post_author_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/profile_picture"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/post_author_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/heart_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/post_author_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/heart_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/post_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/heart_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/post_follow_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:minWidth="64dp"
            android:text="@string/follow"
            android:textAllCaps="false"
            android:textColor="@color/heart_primary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/post_more_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/heart_text" />
    </LinearLayout>

    <!-- Post Image / Media Content -->
    <FrameLayout
        android:id="@+id/post_media_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/post_media_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/post_media"
            android:background="@color/black"
            android:scaleType="fitCenter"
            android:src="@drawable/bg_media_placeholder" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/post_media_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <ProgressBar
            android:id="@+id/post_video_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/post_video_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#99000000"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_playback_failed"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_video"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/retry"
                android:textColor="@color/white"
                android:textAllCaps="false" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_mute_video"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_video_control"
            android:contentDescription="@string/unmute_video"
            android:padding="10dp"
            android:src="@drawable/ic_volume_muted"
            app:tint="@color/white"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/reel_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_reel_overlay_scrim"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="72dp"
            android:paddingEnd="8dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/reel_creator_avatar"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/profile_picture"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile" />

                    <TextView
                        android:id="@+id/reel_creator_username"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reel_follow_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="72dp"
                        android:text="@string/follow"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:visibility="gone"
                        app:strokeColor="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/reel_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="4"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/reel_caption_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/caption_more"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/reel_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/reel_btn_like"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/like"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/reel_like_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/reel_btn_comment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/comment"
                    android:src="@drawable/ic_comment"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/reel_comment_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/reel_btn_repost"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/repost"
                    android:src="@drawable/ic_repost"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/reel_repost_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/reel_btn_share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/share"
                    android:src="@drawable/ic_send"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/reel_share_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/share"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/reel_btn_bookmark"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/bookmark"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/reel_bookmark_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/bookmark"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/reel_btn_more"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/more_options"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/reel_double_tap_heart"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:contentDescription="@string/like"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_selected"
            android:visibility="gone"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/reel_play_pause_indicator"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_video_control"
            android:contentDescription="@string/play_video"
            android:padding="18dp"
            android:src="@drawable/ic_play_video"
            android:visibility="gone"
            app:tint="@color/white" />
    </FrameLayout>

    <!-- Action Bar: engagement actions and their authoritative counts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/like"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:id="@+id/post_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:minWidth="20dp"
                android:gravity="start|center_vertical"
                android:textColor="@color/heart_text"
                android:textSize="12sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_comment"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/comment"
                android:src="@drawable/ic_comment"
                app:tint="@color/heart_text" />

            <TextView
                android:id="@+id/post_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:minWidth="20dp"
                android:gravity="start|center_vertical"
                android:textColor="@color/heart_text"
                android:textSize="12sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_repost"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/repost"
                android:src="@drawable/ic_repost"
                app:tint="@color/heart_text" />

            <TextView
                android:id="@+id/post_repost_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:minWidth="20dp"
                android:gravity="start|center_vertical"
                android:textColor="@color/heart_text"
                android:textSize="12sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_send"
            app:tint="@color/heart_text" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_bookmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bookmark"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/heart_text" />
    </LinearLayout>

    <!-- Caption -->
    <TextView
        android:id="@+id/post_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/heart_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/post_caption_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/heart_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- View All Comments -->
    <TextView
        android:id="@+id/post_comments_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/heart_muted"
        android:textSize="13sp" />

    <!-- Timestamp -->
    <TextView
        android:id="@+id/post_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/heart_muted"
        android:textSize="11sp" />

</LinearLayout>
