<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/heart_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create"
        android:textColor="@color/heart_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/select_photo_frame"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_card"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/create_preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Photo preview"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/select_photo_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/select_photo"
                android:src="@drawable/ic_create" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/select_photo"
                android:textColor="@color/heart_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <EditText
        android:id="@+id/caption_input"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_card"
        android:gravity="top|start"
        android:hint="@string/write_caption"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/location_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_card"
        android:hint="@string/add_location"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_share_post"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/heart_primary"
        android:text="@string/share_post"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
