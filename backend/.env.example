# Browser frontend origin and exact browser CORS allowlist.
FRONTEND_URL=https://cliqhearts.onrender.com
ALLOWED_ORIGINS=https://cliqhearts.onrender.com,http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=365d

# Cloudinary API credentials belong only in the backend environment.
CLOUDINARY_CLOUD_NAME=dlfvdqs3
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_rotated_cloudinary_api_secret

